DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/faq_chatbot

SIMILARITY_BACKEND=fuzzy
# Vencedor da avaliação (ver README, "Decisão: comparação dos três protótipos
# de similaridade"): SIMILARITY_BACKEND=embedding, 90.5% de acurácia no
# gabarito vs 76.2% do fuzzy. Padrão aqui continua fuzzy para não exigir
# OPENAI_API_KEY só para subir a stack pela primeira vez.
SIMILARITY_THRESHOLD=0.6

OPENAI_API_KEY=
OPENAI_MODEL=text-embedding-3-small

ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

JWT_SECRET_KEY=change-me-in-production
